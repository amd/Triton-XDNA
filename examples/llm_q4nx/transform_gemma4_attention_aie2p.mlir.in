// Schedule of gemma4_attention.attn on one attention column (aie2p): one
// herd of NQT cores in a column. gemma4_attention.schedule
// fills in R (q rows a round), R8 = R / 8, MB = LKP / 8 (8-row blocks a core
// takes, and K blocks of S), KB = DH / 8, DVC = DH / DVT and VB = DVT / 8.
//
// Both matmuls work on 8x8 blocks (pack [8, 8, 8]); the DMAs into the cores
// do the blocking. S, P, the row state and acc stay blocked, so the softmax
// runs on the blocks and only the transfer of the output out of the cores
// unblocks. Per round each of the NQT cores holds its rows of q in L1; per K
// block it gets K whole and V a DVT-wide chunk at a time, and updates acc a
// block at a time with that block's P V.
module attributes {transform.with_named_sequence} {
  // Packs of the row state only reshape it ([R, 1] in blocks of 8 rows):
  // lower them to reshapes.
  transform.named_sequence @lower_pack(%p: !transform.any_op {transform.readonly}) {
    %t = transform.cast %p : !transform.any_op to !transform.op<"linalg.pack">
    %a, %b, %c = transform.structured.lower_pack %t : (!transform.op<"linalg.pack">) -> (!transform.op<"tensor.pad">, !transform.op<"tensor.expand_shape">, !transform.op<"linalg.transpose">)
    transform.yield
  }
  transform.named_sequence @lower_unpack(%p: !transform.any_op {transform.readonly}) {
    %t = transform.cast %p : !transform.any_op to !transform.op<"linalg.unpack">
    %a, %b, %c, %d, %e = transform.structured.lower_unpack %t : (!transform.op<"linalg.unpack">) -> (!transform.op<"tensor.empty">, !transform.op<"linalg.transpose">, !transform.op<"tensor.collapse_shape">, !transform.op<"tensor.extract_slice">, !transform.op<"linalg.copy">)
    transform.yield
  }
  transform.named_sequence @lower_row_packs(%f: !transform.any_op {transform.readonly}) {
    %p0 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x8xbf16> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %p0 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %p1 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x8xf32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %p1 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %p2 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x8xi32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %p2 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %p3 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{MB}x8xi32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %p3 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %u0 = transform.structured.match ops{["linalg.unpack"]} filter_result_type = tensor<{R}xbf16> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %u0 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_unpack failures(propagate) (%x) : (!transform.any_op) -> () }
    %u1 = transform.structured.match ops{["linalg.unpack"]} filter_result_type = tensor<{R}xf32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %u1 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_unpack failures(propagate) (%x) : (!transform.any_op) -> () }
    %pp0 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x1x8xbf16> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %pp0 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %pp1 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x1x8xf32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %pp1 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %pp2 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x1x8xi32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %pp2 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_pack failures(propagate) (%x) : (!transform.any_op) -> () }
    %uu0 = transform.structured.match ops{["linalg.unpack"]} filter_result_type = tensor<{R}x1xbf16> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %uu0 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_unpack failures(propagate) (%x) : (!transform.any_op) -> () }
    %uu1 = transform.structured.match ops{["linalg.unpack"]} filter_result_type = tensor<{R}x1xf32> in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %uu1 : !transform.any_op { ^bb0(%x: !transform.any_op): transform.include @lower_unpack failures(propagate) (%x) : (!transform.any_op) -> () }
    // The unpacks' copies into fresh tensors are identities.
    %cp = transform.structured.match ops{["linalg.copy"]} in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %cp : !transform.any_op { ^bb0(%x: !transform.any_op): %g = transform.structured.generalize %x : (!transform.any_op) -> !transform.any_op }
    %tr = transform.structured.match ops{["linalg.transpose"]} in %f : (!transform.any_op) -> !transform.any_op
    transform.foreach %tr : !transform.any_op { ^bb0(%x: !transform.any_op): %g = transform.structured.generalize %x : (!transform.any_op) -> !transform.any_op }
    transform.apply_patterns to %f {
      transform.apply_patterns.linalg.fold_unit_extent_dims_via_reshapes
      transform.apply_patterns.tensor.reassociative_reshape_folding
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    transform.apply_cse to %f : !transform.any_op
    transform.yield
  }
  // Vector tiles, chosen per op by the matchers below in order; a 4-D
  // elementwise op or fill none of them takes goes two rows of a block at a
  // time.
  // P V's contraction on one block of acc: its K loop unrolled, so the P
  // blocks it reads are the same for every block of acc and come out of
  // acc's loops. On two by two blocks it goes as Q K's does, below.
  transform.named_sequence @match_pv_contract(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic"] : !transform.any_op
    %r, %k, %i = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      %kd = transform.match.structured.dim %s[2] : (!transform.any_op) -> !transform.param<i64>
      %id = transform.match.structured.dim %s[0] : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %rk, %kd, %id : !transform.param<i64>, !transform.param<i64>, !transform.param<i64>
    }
    %six = transform.param.constant 6 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %six : !transform.param<i64>
    %mb = transform.param.constant {MB} : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %k, %mb : !transform.param<i64>
    %one = transform.param.constant 1 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %i, %one : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @tile_pv_contract(%op: !transform.any_op {transform.consumed}) {
    %t, %l:3 = transform.structured.tile_using_for %op tile_sizes [1, 1, 1, 0, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)
    transform.loop.unroll %l#2 factor = {MB} : !transform.any_op
    transform.yield
  }
  // P and the output's scaling, which spread a row value over a block, a
  // block at a time: the spread is then one transpose of the block.
  transform.named_sequence @match_row_scaled(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic"] : !transform.any_op
    %r, %n = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.dim %s[all] parallel : !transform.any_op
      %ni = transform.match.structured.num_inputs %s : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %rk, %ni : !transform.param<i64>, !transform.param<i64>
    }
    %four = transform.param.constant 4 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %four : !transform.param<i64>
    %two = transform.param.constant 2 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %n, %two : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @tile_blocks(%op: !transform.any_op {transform.consumed}) {
    %t, %l:2 = transform.structured.tile_using_for %op tile_sizes [1, 1, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    transform.yield
  }
  // S, and acc when it goes two by two, two by two blocks at a time: the
  // four blocks' sums run as four independent multiply-accumulate chains
  // through the K loop, and each block's next op then works on its sums
  // straight from the loop.
  transform.named_sequence @match_qk_2x2(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic"] : !transform.any_op
    %r, %d0, %d1 = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      %a = transform.match.structured.dim %s[0] : (!transform.any_op) -> !transform.param<i64>
      %b = transform.match.structured.dim %s[1] : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %rk, %a, %b : !transform.param<i64>, !transform.param<i64>, !transform.param<i64>
    }
    %six = transform.param.constant 6 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %six : !transform.param<i64>
    %two = transform.param.constant 2 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %d0, %two : !transform.param<i64>
    transform.match.param.cmpi eq %d1, %two : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @tile_qk_2x2(%op: !transform.any_op {transform.consumed}) {
    %t, %l:3 = transform.structured.tile_using_for %op tile_sizes [1, 1, 1, 0, 0, 0] interchange = [2, 0, 1, 3, 4, 5] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)
    transform.loop.unroll %l#2 factor = 2 : !transform.any_op
    transform.loop.unroll %l#1 factor = 2 : !transform.any_op
    transform.yield
  }
  transform.named_sequence @match_2x2_blocks(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic", "linalg.fill"] : !transform.any_op
    %r, %d0, %d1 = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.dim %s[all] parallel : !transform.any_op
      %a = transform.match.structured.dim %s[0] : (!transform.any_op) -> !transform.param<i64>
      %b = transform.match.structured.dim %s[1] : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %rk, %a, %b : !transform.param<i64>, !transform.param<i64>, !transform.param<i64>
    }
    %four = transform.param.constant 4 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %four : !transform.param<i64>
    %two = transform.param.constant 2 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %d0, %two : !transform.param<i64>
    transform.match.param.cmpi eq %d1, %two : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @tile_2x2_blocks(%op: !transform.any_op {transform.consumed}) {
    %t, %l:2 = transform.structured.tile_using_for %op tile_sizes [1, 1, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    transform.loop.unroll %l#1 factor = 2 : !transform.any_op
    transform.loop.unroll %l#0 factor = 2 : !transform.any_op
    transform.yield
  }
  transform.named_sequence @match_rank4(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic", "linalg.fill"] : !transform.any_op
    %r = transform.match.structured %op : (!transform.any_op) -> !transform.param<i64> {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.dim %s[all] parallel : !transform.any_op
      transform.match.structured.yield %rk : !transform.param<i64>
    }
    %four = transform.param.constant 4 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %four : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @tile_rows(%op: !transform.any_op {transform.consumed}) {
    %t, %l:3 = transform.structured.tile_using_for %op tile_sizes [1, 1, 2, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)
    transform.yield
  }
  // acc's update, acc * a + P V, a whole block at a time: a's row values
  // spread over the block once, and the block's sums in one pass.
  transform.named_sequence @match_acc_upd(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic"] : !transform.any_op
    %bw = transform.match.structured %op : (!transform.any_op) -> !transform.param<i64> {
    ^bb0(%s: !transform.any_op):
      transform.match.structured.dim %s[all] parallel : !transform.any_op
      %n = transform.match.structured.num_inputs %s : (!transform.any_op) -> !transform.param<i64>
      %two = transform.param.constant 2 : i64 -> !transform.param<i64>
      transform.match.param.cmpi eq %n, %two : !transform.param<i64>
      %pv = transform.match.structured.input %s[1] permutation : (!transform.any_op) -> !transform.any_value
      %b = transform.match.structured.elemental_bitwidth %pv : (!transform.any_value) -> !transform.param<i64>
      transform.match.structured.yield %b : !transform.param<i64>
    }
    %c32 = transform.param.constant 32 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %bw, %c32 : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  // acc's update on two by two blocks, from the four sums of P V's blocks.
  transform.named_sequence @match_acc_upd_2x2(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    %u = transform.include @match_acc_upd failures(propagate) (%op) : (!transform.any_op) -> !transform.any_op
    %r, %d0, %d1 = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      %a = transform.match.structured.dim %s[0] : (!transform.any_op) -> !transform.param<i64>
      %b = transform.match.structured.dim %s[1] : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %rk, %a, %b : !transform.param<i64>, !transform.param<i64>, !transform.param<i64>
    }
    %four = transform.param.constant 4 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %four : !transform.param<i64>
    %two = transform.param.constant 2 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %d0, %two : !transform.param<i64>
    transform.match.param.cmpi eq %d1, %two : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @keep(%op: !transform.any_op {transform.readonly}) {
    transform.yield
  }
  // An op on one block whole: P V's zero, whose store then forwards into the
  // contraction as a constant, a block's partial row reductions, and its
  // mask, which then takes S straight from the contraction.
  transform.named_sequence @match_block(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic", "linalg.fill"] : !transform.any_op
    %d0, %d1 = transform.match.structured %op : (!transform.any_op) -> (!transform.param<i64>, !transform.param<i64>) {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      %four = transform.param.constant 4 : i64 -> !transform.param<i64>
      transform.match.param.cmpi eq %rk, %four : !transform.param<i64>
      transform.match.structured.dim %s[all] parallel : !transform.any_op
      %a = transform.match.structured.dim %s[0] : (!transform.any_op) -> !transform.param<i64>
      %b = transform.match.structured.dim %s[1] : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.yield %a, %b : !transform.param<i64>, !transform.param<i64>
    }
    %one = transform.param.constant 1 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %d0, %one : !transform.param<i64>
    transform.match.param.cmpi eq %d1, %one : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @match_red4(%op: !transform.any_op {transform.readonly}) -> !transform.any_op {
    transform.match.operation_name %op ["linalg.generic"] : !transform.any_op
    %r = transform.match.structured %op : (!transform.any_op) -> !transform.param<i64> {
    ^bb0(%s: !transform.any_op):
      %rk = transform.match.structured.rank %s : (!transform.any_op) -> !transform.param<i64>
      transform.match.structured.dim %s[1, 3] reduction : !transform.any_op
      transform.match.structured.yield %rk : !transform.param<i64>
    }
    %four = transform.param.constant 4 : i64 -> !transform.param<i64>
    transform.match.param.cmpi eq %r, %four : !transform.param<i64>
    transform.yield %op : !transform.any_op
  }
  transform.named_sequence @split_red(%op: !transform.any_op {transform.consumed}) {
    %rb, %rbl = transform.structured.tile_using_for %op tile_sizes [1, 0, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %init, %part, %merge, %loop = transform.structured.tile_reduction_using_for %rb reduction_dims = [1, 3] by tile_sizes = [0, 1, 0, 8] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op, !transform.any_op)
    %mg = transform.structured.generalize %merge : (!transform.any_op) -> !transform.any_op
    transform.yield
  }
  transform.named_sequence @__transform_main(%arg1: !transform.any_op {transform.readonly}) {
    %f = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    // The loads' L2 buffers allocated once, outside the loops. They are the
    // only allocations at this point.
    transform.air.hoist_static_alloc %f : (!transform.any_op) -> ()
    %loops0 = transform.structured.match ops{["scf.for"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %kv_loop0, %rounds_loop = transform.split_handle %loops0 : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.annotate %kv_loop0 "kv_loop" : !transform.any_op
    transform.annotate %rounds_loop "rounds_loop" : !transform.any_op
    // Row reductions over the innermost dim, as generics.
    %reds = transform.structured.match ops{["linalg.reduce"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %reds2 = transform.air.transpose_reduce %reds : (!transform.any_op) -> !transform.any_op
    %reds3 = transform.structured.match ops{["linalg.reduce"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %red_g = transform.structured.generalize %reds3 : (!transform.any_op) -> !transform.any_op
    // Both matmuls in 8x8 blocks; QK reads K as stored, [n, k].
    %mm0 = transform.structured.match ops{["linalg.matmul"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %mm_qk, %mm_pv = transform.split_handle %mm0 : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %qk_tb = transform.structured.transpose_matmul %mm_qk <rhs> : (!transform.any_op) -> !transform.any_op
    %pqk = transform.structured.pack %qk_tb packed_sizes = [8, 8, 8] : (!transform.any_op) -> (!transform.any_op)
    %ppv = transform.structured.pack %mm_pv packed_sizes = [8, 8, 8] : (!transform.any_op) -> (!transform.any_op)
    // V's blocks as stored, [k, n]: a DMA moves 16-bit data only with unit
    // innermost stride.
    %pv_b = transform.get_producer_of_operand %ppv[1] : (!transform.any_op) -> !transform.any_op
    %ppv2, %pv_bp, %pv_bu = transform.structured.pack_transpose %pv_b with_compute_op(%ppv) inner_perm = [1, 0] : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    transform.annotate %pqk "qk_mm" : !transform.any_op
    transform.apply_patterns to %f {
      transform.apply_patterns.linalg.data_layout_propagation
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    // The row reductions in the blocks S comes in.
    transform.foreach %red_g : !transform.any_op {
    ^bb0(%op: !transform.any_op):
      %p = transform.structured.pack %op packed_sizes = [8, 8] : (!transform.any_op) -> (!transform.any_op)
    }
    transform.apply_patterns to %f {
      transform.apply_patterns.linalg.data_layout_propagation
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    transform.apply_cse to %f : !transform.any_op
    // The state stays packed across the K loop.
    %kvl = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %kvl2, %hp = transform.air.hoist_loop_carried_pack %kvl : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.include @lower_row_packs failures(propagate) (%f) : (!transform.any_op) -> ()
    // The epilogue on the packed acc.
    transform.apply_patterns to %f {
      transform.apply_patterns.linalg.data_layout_propagation
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    transform.include @lower_row_packs failures(propagate) (%f) : (!transform.any_op) -> ()
    %kvl3 = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_licm to %kvl3 : !transform.any_op
    // In-place state updates: m and l read and write their state; acc's
    // rescale, P V add and rounding in one op that updates acc.
    %kvl5 = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %y0 = transform.structured.match ops{["scf.yield"]} in %kvl5 : (!transform.any_op) -> !transform.any_op
    // m crosses the loop as [R], reshaped to its blocks.
    %m_c0 = transform.get_producer_of_operand %y0[0] : (!transform.any_op) -> !transform.any_op
    %m_op0 = transform.get_producer_of_operand %m_c0[0] : (!transform.any_op) -> !transform.any_op
    %l_op0 = transform.get_producer_of_operand %y0[1] : (!transform.any_op) -> !transform.any_op
    %a_op0 = transform.get_producer_of_operand %y0[2] : (!transform.any_op) -> !transform.any_op
    transform.annotate %m_op0 "res_m" : !transform.any_op
    transform.annotate %l_op0 "res_l" : !transform.any_op
    %l_mul = transform.get_producer_of_operand %l_op0[0] : (!transform.any_op) -> !transform.any_op
    %a_add = transform.get_producer_of_operand %a_op0[0] : (!transform.any_op) -> !transform.any_op
    %a_ext = transform.get_producer_of_operand %a_add[0] : (!transform.any_op) -> !transform.any_op
    %a_mm = transform.get_producer_of_operand %a_add[1] : (!transform.any_op) -> !transform.any_op
    %a_mul = transform.get_producer_of_operand %a_ext[0] : (!transform.any_op) -> !transform.any_op
    transform.annotate %a_mm "pv_mm" : !transform.any_op
    %a_me = transform.air.fuse_multi_op_linalg %a_mul, %a_ext : (!transform.any_op, !transform.any_op) -> !transform.any_op
    %a_mea = transform.air.fuse_multi_op_linalg %a_me, %a_add : (!transform.any_op, !transform.any_op) -> !transform.any_op
    %a_upd = transform.air.fuse_truncf_linalg %a_op0, %a_mea : (!transform.any_op, !transform.any_op) -> !transform.any_op
    transform.annotate %a_upd "res_acc" : !transform.any_op
    %ri_m = transform.air.reuse_input_as_init %m_op0 : (!transform.any_op) -> !transform.any_op
    %l_upd = transform.air.fuse_multi_op_linalg %l_mul, %l_op0 : (!transform.any_op, !transform.any_op) -> !transform.any_op
    transform.annotate %l_upd "res_l" : !transform.any_op
    %ri_l = transform.air.reuse_input_as_init %l_upd : (!transform.any_op) -> !transform.any_op
    %ri_a = transform.air.reuse_input_as_init %a_upd : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %f { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %f : !transform.any_op
    // m crosses the loop as [R] once its packs are reshapes: carry it in
    // blocks too.
    %kvlh = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.sequence %kvlh : !transform.any_op failures(suppress) {
    ^bb0(%l: !transform.any_op):
      %l2, %h2 = transform.air.hoist_loop_carried_pack %l : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    }
    transform.apply_patterns to %f { transform.apply_patterns.canonicalization } : !transform.any_op
    // Elementwise chains fused once, on the whole round: each element
    // computed once.
    %fe = transform.air.fuse_elementwise_linalg %f fold_reshapes no_recompute : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    %kvly = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %yy = transform.structured.match ops{["scf.yield"]} in %kvly : (!transform.any_op) -> !transform.any_op
    %py0 = transform.get_producer_of_operand %yy[0] : (!transform.any_op) -> !transform.any_op
    %py1 = transform.get_producer_of_operand %yy[1] : (!transform.any_op) -> !transform.any_op
    %py2 = transform.get_producer_of_operand %yy[2] : (!transform.any_op) -> !transform.any_op
    transform.annotate %py0 "res_l" : !transform.any_op
    transform.annotate %py1 "res_acc" : !transform.any_op
    transform.annotate %py2 "res_m" : !transform.any_op
    // q to L1 once a round, each core its MB blocks.
    %qpk = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{R8}x{KB}x8x8xbf16> in %arg1 : (!transform.any_op) -> !transform.any_op
    %bq, %nq = transform.structured.bufferize_to_allocation %qpk <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    %q_t, %q_f = transform.structured.fuse %qpk tile_sizes [{MB}, 0, 0, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.annotate %q_f "f_q" : !transform.any_op
    // PHASE 2: the round's rows over the NQT cores, MB 8-row blocks each.
    %m_op = transform.structured.match ops{["linalg.generic"]} attributes{res_m} in %arg1 : (!transform.any_op) -> !transform.any_op
    %l_op = transform.structured.match ops{["linalg.generic"]} attributes{res_l} in %arg1 : (!transform.any_op) -> !transform.any_op
    %a_op = transform.structured.match ops{["linalg.generic"]} attributes{res_acc} in %arg1 : (!transform.any_op) -> !transform.any_op
    %a_t, %a_f = transform.structured.fuse %a_op tile_sizes [{MB}, 0, 0, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %l_t, %l_f = transform.structured.fuse %l_op tile_sizes [{MB}, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %m_t, %m_f = transform.structured.fuse %m_op tile_sizes [{MB}, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.annotate %a_f "f_acc" : !transform.any_op
    transform.annotate %l_f "f_l" : !transform.any_op
    transform.annotate %m_f "f_m" : !transform.any_op
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    %m3 = transform.structured.match ops{["scf.forall"]} attributes{f_m} in %arg1 : (!transform.any_op) -> !transform.any_op
    %l3 = transform.structured.match ops{["scf.forall"]} attributes{f_l} in %arg1 : (!transform.any_op) -> !transform.any_op
    %a3 = transform.structured.match ops{["scf.forall"]} attributes{f_acc} in %arg1 : (!transform.any_op) -> !transform.any_op
    // V (and its reshape) into the acc loop, so the loop needs nothing
    // made after the m and l loops.
    %vcol = transform.structured.match ops{["tensor.collapse_shape"]} filter_result_type = tensor<{MB}x{KB}x8x8xbf16> in %arg1 : (!transform.any_op) -> !transform.any_op
    %vpk = transform.get_producer_of_operand %vcol[0] : (!transform.any_op) -> !transform.any_op
    %vc_in, %a4 = transform.structured.fuse_into_containing_op %vcol into %a3 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %vp_in, %a5 = transform.structured.fuse_into_containing_op %vpk into %a4 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %ml = transform.loop.fuse_sibling %l3 into %m3 : (!transform.any_op, !transform.any_op) -> !transform.any_op
    %mla = transform.loop.fuse_sibling %a5 into %ml : (!transform.any_op, !transform.any_op) -> !transform.any_op
    %round0 = transform.air.fold_extract_slice_of_insert_slice %mla : (!transform.any_op) -> !transform.any_op
    transform.annotate %round0 "f_round" : !transform.any_op
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    // K into each core's L1 (one transfer to all of them).
    %rnd = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    %qkm = transform.structured.match ops{["linalg.generic"]} attributes{qk_mm} in %rnd : (!transform.any_op) -> !transform.any_op
    %kpk = transform.get_producer_of_operand %qkm[1] : (!transform.any_op) -> !transform.any_op
    %kp_in, %rnd2 = transform.structured.fuse_into_containing_op %kpk into %rnd : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    // Before the K loop: the state's initial values, made each round, in L1,
    // each core its rows, in one loop.
    %rl = transform.structured.match ops{["scf.for"]} attributes{rounds_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %kvp = transform.structured.match ops{["scf.for"]} attributes{kv_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %pi_l0 = transform.get_producer_of_operand %kvp[3] : (!transform.any_op) -> !transform.any_op
    %pi_a0 = transform.get_producer_of_operand %kvp[4] : (!transform.any_op) -> !transform.any_op
    %pi_m0 = transform.get_producer_of_operand %kvp[5] : (!transform.any_op) -> !transform.any_op
    %pi_m, %rl1 = transform.structured.fuse_into_containing_op %pi_m0 into %rl : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pi_l, %rl2 = transform.structured.fuse_into_containing_op %pi_l0 into %rl1 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pi_a, %rl3 = transform.structured.fuse_into_containing_op %pi_a0 into %rl2 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %bpm, %npm = transform.structured.bufferize_to_allocation %pi_m <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    %bpl, %npl = transform.structured.bufferize_to_allocation %pi_l <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    %bpa, %npa = transform.structured.bufferize_to_allocation %pi_a <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    %pa_t, %pa_f = transform.structured.fuse %pi_a tile_sizes [{MB}, 0, 0, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pl_t, %pl_f = transform.structured.fuse %pi_l tile_sizes [{MB}, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pm_t, %pm_f = transform.structured.fuse %pi_m tile_sizes [{MB}, 0] use_forall apply_cleanup : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pro01 = transform.loop.fuse_sibling %pl_f into %pa_f : (!transform.any_op, !transform.any_op) -> !transform.any_op
    %pro012 = transform.loop.fuse_sibling %pm_f into %pro01 : (!transform.any_op, !transform.any_op) -> !transform.any_op
    transform.annotate %pro012 "f_pro" : !transform.any_op
    // After the K loop: out = acc / l per core, unpacked by the transfer to
    // L2, 8 rows by 32 columns at a time (three dims for the core's DMA, and
    // little L1), each made just before it goes.
    %stores = transform.structured.match ops{["bufferization.materialize_in_destination"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %out_up = transform.get_producer_of_operand %stores[0] : (!transform.any_op) -> !transform.any_op
    %out_op = transform.get_producer_of_operand %out_up[0] : (!transform.any_op) -> !transform.any_op
    %inv = transform.get_producer_of_operand %out_op[1] : (!transform.any_op) -> !transform.any_op
    %bo, %no = transform.structured.bufferize_to_allocation %out_up <{memory_space = 1, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    %o_t, %o_f = transform.structured.tile_using_forall %out_up tile_sizes [{LKP}, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %o1, %of1a = transform.structured.fuse_into_containing_op %out_op into %o_f : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    // The rows' reciprocals, made once in each core.
    %inv1, %of1 = transform.structured.fuse_into_containing_op %inv into %of1a : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %binv, %ninv = transform.structured.bufferize_to_allocation %inv1 <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    transform.annotate %of1 "f_out" : !transform.any_op
    %o_up = transform.structured.match ops{["linalg.unpack"]} in %of1 : (!transform.any_op) -> !transform.any_op
    %o_upt, %o_upl0:2 = transform.structured.tile_using_for %o_up tile_sizes [8, 32] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    // Counting blocks, so the block's offset in acc is the loops' indices:
    // what each core reads of acc shows as its own rows.
    %o_upl = transform.air.normalize_loop_to_unit_step %o_upl0#0 : (!transform.any_op) -> !transform.any_op
    %o_upc = transform.air.normalize_loop_to_unit_step %o_upl0#1 : (!transform.any_op) -> !transform.any_op
    %o2, %o_upl2 = transform.structured.fuse_into_containing_op %o1 into %o_upc : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %bo2, %no2 = transform.structured.bufferize_to_allocation %o2 <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    transform.apply_patterns to %fe { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe : !transform.any_op
    // The key-column index is made in each core.
    %rndc = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    %colg = transform.structured.match ops{["linalg.generic"]} filter_result_type = tensor<{MB}x8xi32> in %arg1 : (!transform.any_op) -> !transform.any_op
    %colf, %rndc2 = transform.structured.fuse_into_containing_op %colg into %rndc : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    // S two by two blocks at a time, made where the mask takes it: its f32
    // sums go straight from the contraction to the mask, never to L1.
    %rnd5 = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    %qk5 = transform.structured.match ops{["linalg.generic"]} attributes{qk_mm} in %rnd5 : (!transform.any_op) -> !transform.any_op
    %mask5 = transform.get_consumers_of_result %qk5[0] : (!transform.any_op) -> !transform.any_op
    %mask5t, %maskl:2 = transform.structured.tile_using_for %mask5 tile_sizes [2, 2, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    %qk6, %maskl2 = transform.structured.fuse_into_containing_op %qk5 into %maskl#1 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %qki_sl = transform.get_producer_of_operand %qk6[2] : (!transform.any_op) -> !transform.any_op
    %qki = transform.get_producer_of_operand %qki_sl[0] : (!transform.any_op) -> !transform.any_op
    %qki2, %maskl3 = transform.structured.fuse_into_containing_op %qki into %maskl2 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %fs = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fs {
      transform.apply_patterns.tensor.fold_tensor_empty
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    // P over S: S is read for the row maxima before P is made.
    %rnd6 = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    // P is the block-shaped op with an exp2; the row rescale's exp2 has no
    // input of its result's type.
    %e6 = transform.structured.match ops{["math.exp2"]} in %rnd6 : (!transform.any_op) -> !transform.any_op
    %p6 = transform.get_parent_op %e6 <{deduplicate, op_name = "linalg.generic"}> : (!transform.any_op) -> !transform.any_op
    transform.foreach %p6 : !transform.any_op {
    ^bb0(%g: !transform.any_op):
      transform.sequence %g : !transform.any_op failures(suppress) {
      ^bb1(%g1: !transform.any_op):
        %gi = transform.air.reuse_input_as_init %g1 : (!transform.any_op) -> !transform.any_op
      }
    }
    // Row reductions: a row block's column blocks combined elementwise into
    // a block of partials, then one transpose and reduction of that block.
    %rnd7 = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach_match in %rnd7 @match_red4 -> @split_red : (!transform.any_op) -> !transform.any_op
    // acc in chunks of V's tiles, V brought per chunk; inside a chunk, a tile
    // of acc at a time with its P V: a block, or two by two blocks when P V's
    // K loop is long.
    %rnd4 = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    %acc4 = transform.structured.match ops{["linalg.generic"]} attributes{res_acc} in %rnd4 : (!transform.any_op) -> !transform.any_op
    %acc4z, %zl = transform.structured.tile_using_for %acc4 tile_sizes [0, {VB}, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    transform.annotate %zl "v_chunk_loop" : !transform.any_op
    %pv4 = transform.structured.match ops{["linalg.generic"]} attributes{pv_mm} in %rnd4 : (!transform.any_op) -> !transform.any_op
    %pvz, %zl2 = transform.structured.fuse_into_containing_op %pv4 into %zl : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %fz = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %fz2 = transform.air.bubble_slice_through_collapse %fz : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fz2 { transform.apply_patterns.canonicalization } : !transform.any_op
    %zl3 = transform.structured.match ops{["scf.for"]} attributes{v_chunk_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    %vpk4 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{MB}x{DVC}x{VB}x8x8xbf16> in %arg1 : (!transform.any_op) -> !transform.any_op
    %vpz, %zl4 = transform.structured.fuse_into_containing_op %vpk4 into %zl3 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pvz2 = transform.structured.match ops{["linalg.generic"]} attributes{pv_mm} in %zl4 : (!transform.any_op) -> !transform.any_op
    %pvi_sl = transform.get_producer_of_operand %pvz2[2] : (!transform.any_op) -> !transform.any_op
    %pvi = transform.get_producer_of_operand %pvi_sl[0] : (!transform.any_op) -> !transform.any_op
    %pvi_z, %zl5 = transform.structured.fuse_into_containing_op %pvi into %zl4 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %acc5 = transform.structured.match ops{["linalg.generic"]} attributes{res_acc} in %zl5 : (!transform.any_op) -> !transform.any_op
    %acc5t, %accl:2 = transform.structured.tile_using_for %acc5 tile_sizes [{AT}, {AT}, 0, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    transform.annotate %accl#1 "acc_block_loop" : !transform.any_op
    %pv5 = transform.structured.match ops{["linalg.generic"]} attributes{pv_mm} in %zl5 : (!transform.any_op) -> !transform.any_op
    %pv5f, %accl2 = transform.structured.fuse_into_containing_op %pv5 into %accl#1 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %pv_init_sl = transform.get_producer_of_operand %pv5f[2] : (!transform.any_op) -> !transform.any_op
    %pv_init = transform.get_producer_of_operand %pv_init_sl[0] : (!transform.any_op) -> !transform.any_op
    %pvi_f, %accl3 = transform.structured.fuse_into_containing_op %pv_init into %accl2 : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %fe4 = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fe4 { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fe4 : !transform.any_op
    // PHASE 3: K and V into L1 per core; bufferize; herds.
    %f3 = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %rnd3 = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    %kp3 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{MB}x{KB}x8x8xbf16> in %rnd3 : (!transform.any_op) -> !transform.any_op
    %bk3, %nk3 = transform.structured.bufferize_to_allocation %kp3 <{memory_space = 2, bufferize_destination_only, emit_dealloc}> : !transform.any_op
    // One buffer for V's chunks, made outside the chunk loop: a core holds
    // one chunk at a time.
    transform.apply_patterns to %f3 { transform.apply_patterns.tensor.fold_tensor_empty } : !transform.any_op
    %zl6 = transform.structured.match ops{["scf.for"]} attributes{v_chunk_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_licm to %zl6 : !transform.any_op
    %vp3 = transform.structured.match ops{["linalg.pack"]} filter_result_type = tensor<{MB}x1x{VB}x8x8xbf16> in %rnd3 : (!transform.any_op) -> !transform.any_op
    %vd3 = transform.get_producer_of_operand %vp3[1] : (!transform.any_op) -> !transform.any_op
    %vd3e = transform.cast %vd3 : !transform.any_op to !transform.op<"tensor.empty">
    %vd3a = transform.bufferization.empty_tensor_to_alloc_tensor %vd3e : (!transform.op<"tensor.empty">) -> !transform.op<"bufferization.alloc_tensor">
    transform.apply_patterns to %f3 { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %f3 : !transform.any_op
    transform.bufferization.eliminate_empty_tensors %f3 : !transform.any_op
    %fb = transform.bufferization.one_shot_bufferize %f3 : (!transform.any_op) -> !transform.any_op
    %fb2 = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fb2 { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fb2 : !transform.any_op
    %fa_f_q = transform.structured.match ops{["scf.forall"]} attributes{f_q} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %fa_f_q : !transform.any_op {
    ^bb0(%fl: !transform.any_op):
      %pl = transform.loop.forall_to_parallel %fl : (!transform.any_op) -> !transform.any_op
      %hl = transform.air.par_to_herd %pl <{first_dim = 1}> : (!transform.any_op) -> !transform.any_op
    }
    %fa_f_pro_m = transform.structured.match ops{["scf.forall"]} attributes{f_pro_m} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %fa_f_pro_m : !transform.any_op {
    ^bb0(%fl: !transform.any_op):
      %pl = transform.loop.forall_to_parallel %fl : (!transform.any_op) -> !transform.any_op
      %hl = transform.air.par_to_herd %pl <{first_dim = 1}> : (!transform.any_op) -> !transform.any_op
    }
    %fa_f_pro = transform.structured.match ops{["scf.forall"]} attributes{f_pro} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %fa_f_pro : !transform.any_op {
    ^bb0(%fl: !transform.any_op):
      %pl = transform.loop.forall_to_parallel %fl : (!transform.any_op) -> !transform.any_op
      %hl = transform.air.par_to_herd %pl <{first_dim = 1}> : (!transform.any_op) -> !transform.any_op
    }
    %fa_f_round = transform.structured.match ops{["scf.forall"]} attributes{f_round} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %fa_f_round : !transform.any_op {
    ^bb0(%fl: !transform.any_op):
      %pl = transform.loop.forall_to_parallel %fl : (!transform.any_op) -> !transform.any_op
      %hl = transform.air.par_to_herd %pl <{first_dim = 1}> : (!transform.any_op) -> !transform.any_op
    }
    %fa_f_out = transform.structured.match ops{["scf.forall"]} attributes{f_out} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %fa_f_out : !transform.any_op {
    ^bb0(%fl: !transform.any_op):
      %pl = transform.loop.forall_to_parallel %fl : (!transform.any_op) -> !transform.any_op
      %hl = transform.air.par_to_herd %pl <{first_dim = 1}> : (!transform.any_op) -> !transform.any_op
    }
    %hs = transform.structured.match ops{["air.herd"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %hs2 = transform.air.override_memref_memory_space %hs <{memory_space = 2 : i32}> : (!transform.any_op) -> !transform.any_op
    %hs3 = transform.structured.match ops{["air.herd"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %n_attn = transform.param.constant "attn" -> !transform.any_param
    transform.annotate %hs3 "sym_name" = %n_attn : !transform.any_op, !transform.any_param
    %fh = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fh { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fh : !transform.any_op
    // PHASE 4: vectors.
    %hv0 = transform.structured.match ops{["air.herd"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %hv1 = transform.air.convert_memref_copy_to_linalg_copy %hv0 : (!transform.any_op) -> !transform.any_op
    %fv0 = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %fv1 = transform.foreach_match in %fv0 @match_pv_contract -> @tile_pv_contract, @match_qk_2x2 -> @tile_qk_2x2, @match_acc_upd_2x2 -> @tile_2x2_blocks, @match_acc_upd -> @keep, @match_block -> @keep, @match_2x2_blocks -> @tile_2x2_blocks, @match_row_scaled -> @tile_blocks, @match_rank4 -> @tile_rows : (!transform.any_op) -> !transform.any_op
    %fv2 = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fv2 { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fv2 : !transform.any_op
    %hv = transform.structured.match ops{["air.herd"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %hvv = transform.air.herd_vectorize %hv : (!transform.any_op) -> !transform.any_op
    %fu = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fu {
      transform.apply_patterns.vector.cast_away_vector_leading_one_dim
      transform.apply_patterns.vector.drop_unit_dims_with_shape_cast
      transform.apply_patterns.vector.drop_inner_most_unit_dims_from_xfer_ops
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    // A block's row reductions as one transpose and elementwise ops across
    // its columns.
    %fr = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fr {
      transform.apply_patterns.vector.reorder_multi_reduction_dims lowering_strategy = "innerparallel"
      transform.apply_patterns.vector.multi_reduction_flattening lowering_strategy = "innerparallel"
      transform.apply_patterns.vector.multi_reduction_unrolling lowering_strategy = "innerparallel"
      transform.apply_patterns.vector.cast_away_vector_leading_one_dim
      transform.apply_patterns.canonicalization
    } : !transform.any_op
    // A row's value spread over its 8 columns comes as a broadcast and a
    // transpose of a 16-element vector; as a 1-D shuffle instead.
    %ft = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %ft {
      transform.apply_patterns.vector.lower_transpose lowering_strategy = "shuffle_1d"
    } : !transform.any_op
    // Contractions take bf16 and accumulate in f32.
    %vcon = transform.structured.match ops{["vector.contract"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %vcon1 = transform.air.vector_type_cast %vcon <{target_element_type = f32, input_indices = [2], output_indices = [0]}> : (!transform.any_op) -> !transform.any_op
    %vcon2 = transform.structured.match ops{["vector.contract"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %vcon3 = transform.air.vector_type_cast %vcon2 <{target_element_type = bf16, input_indices = [0, 1], output_indices = []}> : (!transform.any_op) -> !transform.any_op
    // The K loop's sums out of memory: read before it, written after.
    %fhv = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    %fhv2 = transform.structured.hoist_redundant_vector_transfers %fhv : (!transform.any_op) -> !transform.any_op
    // Stores read only by later loads become the stored values, and the
    // buffers left unread go. Transfers address their buffers directly
    // first, so that blocks of one buffer are seen to be apart.
    transform.apply_patterns to %fhv2 {
      transform.apply_patterns.memref.fold_memref_alias_ops
    } : !transform.any_op
    transform.memref.erase_dead_alloc_and_stores %fhv2 : (!transform.any_op) -> ()
    // Several tiles of acc a trip: their P V sums are independent, so each
    // one's multiply-accumulates run in the others' latency.
    %abl = transform.structured.match ops{["scf.for"]} attributes{acc_block_loop} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.loop.unroll %abl factor = {AU} : !transform.any_op
    // What a block's loop computes the same way each trip, out of it.
    %hl = transform.structured.match ops{["air.herd"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.foreach %hl : !transform.any_op {
    ^bb0(%h: !transform.any_op):
      %hloops = transform.structured.match ops{["scf.for"]} in %h : (!transform.any_op) -> !transform.any_op
      transform.apply_licm to %hloops : !transform.any_op
    }
    %fw = transform.structured.match ops{["func.func"]} in %arg1 : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fw { transform.apply_patterns.canonicalization } : !transform.any_op
    transform.apply_cse to %fw : !transform.any_op
    transform.yield
  }
}
